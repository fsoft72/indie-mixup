{
	"name": "liwe3-cloudflare-base",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"build": "pnpm --recursive --parallel --filter=!./playground/** run build",
		"predev": "pnpm --recursive --workspace-concurrency=3 $(work/scripts/sync_modules.py --filters) run build",
		"dev": "pnpm --recursive --parallel $(work/scripts/sync_modules.py --filters) run dev",
		"test": "pnpm --recursive --filter=!./playground/** run test",
		"check": "pnpm format:check && pnpm test && pnpm build",
		"build:theme": "pnpm -C liwe3/modules/theme/frontend build:theme && mkdir -p app/frontend/static/theme && cp liwe3/modules/theme/frontend/dist/theme/*.css app/frontend/static/theme/",
		"build:theme:playground": "pnpm -C liwe3/modules/theme/frontend build:theme && mkdir -p playground/frontend/static/theme && cp liwe3/modules/theme/frontend/dist/theme/*.css playground/frontend/static/theme/",
		"build:playground": "pnpm --recursive --parallel --filter=!./app/** run build",
		"dev:playground": "pnpm --recursive --parallel --filter=!./app/** run dev",
		"test:playground": "pnpm --recursive --filter=!./app/** run test",
		"playground:setup": "pnpm -C playground/backend install --ignore-workspace && pnpm -C playground/frontend install --ignore-workspace",
		"playground:migrations": "pnpm -C playground/backend migrations:dev",
		"playground:backend": "pnpm -C playground/backend dev",
		"playground:frontend": "pnpm -C playground/frontend dev",
		"playground:dev": "pnpm playground:backend & pnpm playground:frontend & wait",
		"logs:prod": "pnpm -C app/backend logs:prod"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260814.1",
		"drizzle-kit": "^0.31.8"
	},
	"dependencies": {
		"@liwe3/webcomponents": "file:../liwe3-webcomponents/packages/core",
		"@liwe3/webcomponents-svelte": "file:../liwe3-webcomponents/packages/svelte"
	}
}
