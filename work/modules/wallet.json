    "endp.mwlt0900.txl1": {
      "id": "endp.mwlt0900.txl1",
      "method": "GET",
      "url": "/wallet/transaction/list",
      "short_descr": "List wallet transactions",
      "description": "Return transaction history for a specific wallet with pagination support.\n\nTransactions are returned in descending order (newest first) by default.\n\nOptional filters:\n- `transaction_type`: Filter by 'credit', 'debit', or 'transfer'\n- `date_start` / `date_end`: Filter by date range\n\n**Required permissions:** Logged-in user (owns wallet) or `wallet.admin`",
      "parameters": [
        {
          "id": "param.mwlt0901.id01",
          "type": "str",
          "name": "id_wallet",
          "description": "Wallet ID",
          "is_required": true,
          "is_private": false,
          "is_array": false,
          "is_query": false,
          "query": false,
          "default": "",
          "value": ""
        },
        {
          "id": "param.mwlt0902.ofs1",
          "type": "int",
          "name": "offset",
          "description": "Pagination offset",
          "is_required": false,
          "is_private": false,
          "is_array": false,
          "is_query": false,
          "query": false,
          "default": "0",
          "value": ""
        },
        {
          "id": "param.mwlt0903.lmt1",
          "type": "int",
          "name": "limit",
          "description": "Pagination limit (max results per page)",
          "is_required": false,
          "is_private": false,
          "is_array": false,
          "is_query": false,
          "query": false,
          "default": "50",
          "value": ""
        },
        {
          "id": "param.mwlt0904.typ1",
          "type": "str",
          "name": "transaction_type",
          "description": "Filter by transaction type: 'credit', 'debit', 'transfer'",
          "is_required": false,
          "is_private": false,
          "is_array": false,
          "is_query": false,
          "query": false,
          "default": "",
          "value": ""
        },
        {
          "id": "param.mwlt0905.ds01",
