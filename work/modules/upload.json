    "evt.upload.count": {
      "id": "evt.upload.count",
      "name": "upload.call.count",
      "description": "Count the files inside one or more folders (callable by other modules). Payload: { domain: string, folders: string[] }. Returns { counts: Record<string, number> }, one entry per requested folder. Folders are relative, the domain prefix is added internally"
    },
    "evt.upload.list": {
      "id": "evt.upload.list",
      "name": "upload.call.list",
      "description": "List the files inside a single folder (callable by other modules). Payload: { domain: string, folder: string }. Returns UploadFileList. The folder is relative, the domain prefix is added internally"
    },
    "evt.upload.del": {
      "id": "evt.upload.del",
      "name": "upload.call.del",
      "description": "Delete a file or a complete folder (callable by other modules). Payload: { pattern: string } (same param as upload_del). Forwards the payload to the upload_del method with the caller ctx and returns its response untouched. The pattern must belong to the domain of the caller"
    }
