{
	"actions": [
		{
			"title": "Save current number of comments in DB",
			"method": "GET",
			"url": "/api/comments/list",
			"body": {
				"module": "test",
				"id_obj": "abc123"
			},
			"fields": [["#data", "init_comments"]]
		},
		{
			"method": "POST",
			"url": "/api/comment/add",
			"body": {
				"module": "test",
				"id_obj": "abc123",
				"comment": "Test 01 for test/abc123"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [["data.id", "id_comm"]]
		},
		{
			"method": "POST",
			"url": "/api/comment/add",
			"body": {
				"module": "test",
				"id_obj": "abc123",
				"id_follow_up": "%(id_comm)s",
				"comment": "I agree"
			},
			"fields": [["data.id", "id_follow"]]
		},
		{
			"method": "POST",
			"url": "/api/comment/add",
			"body": {
				"module": "test",
				"id_obj": "abc123",
				"id_follow_up": "%(id_comm)s",
				"comment": "I agree too"
			},
			"fields": [["data.id", "id_follow_2"]]
		},
		{
			"method": "POST",
			"url": "/api/comment/add",
			"body": {
				"module": "test",
				"id_obj": "abc123",
				"id_follow_up": "%(id_follow_2)s",
				"comment": "Sorry I don't"
			}
		},
		{
			"method": "GET",
			"url": "/api/comments/list",
			"body": {
				"module": "test",
				"id_obj": "abc123"
			},
			"tests": [
				{
					"field": "#data",
					"value": "${init_comments + 4}"
				}
			]
		},
		{
			"method": "DELETE",
			"url": "/api/comment/del",
			"body": {
				"id": "%(id_comm)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"method": "GET",
			"url": "/api/comments/list",
			"body": {
				"module": "test",
				"id_obj": "abc123"
			},
			"tests": [
				{
					"field": "#data",
					"value": "${init_comments}"
				}
			]
		},
		{
			"title": "Follow UP tests ended",
			"action": "dump",
			"fields": ["init_comments"]
		}
	]
}
