{
	"actions": [
		{
			"action": "section",
			"title": "User forced password change",
			"actions": [
				{
					"rem": "The passwords come from the environment (.dev.vars): no fixed credential lives in this file. The initial one is the admin password, the new one is the same with a suffix."
				},
				{
					"rem": "The automatic expiry (cfg.user.passwordMaxAgeDays) cannot be checked here, no endpoint lets a test backdate password_changed_at: see tests/user-password-expired.test.ts"
				},
				{
					"action": "copy",
					"from": "admin_token",
					"to": "token"
				},
				{
					"title": "Create the test user",
					"method": "post",
					"url": "/api/user/add",
					"auth": true,
					"body": {
						"username": "pwexp_user_1",
						"email": "pwexp_user_1@example.com",
						"password": "%(system_admin_password)s",
						"enabled": true,
						"email_verified": true
					},
					"status_code": 200,
					"fields": [
						["data.id", "pwexp_user_id"],
						["data.username", "pwexp_username"]
					]
				},
				{
					"title": "Normal login: no password change requested",
					"method": "post",
					"url": "/api/user/login",
					"auth": false,
					"body": {
						"username": "%(pwexp_username)s",
						"password": "%(system_admin_password)s"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.token", "mode": "EXISTS" },
						{ "field": "data.requires_password_change", "mode": "EQUALS", "value": false }
					]
				},
				{
					"title": "Admin forces the password change",
					"method": "post",
					"url": "/api/user/set/password_expired",
					"auth": true,
					"body": {
						"id": "%(pwexp_user_id)s",
						"password_expired": true
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.password_expired", "mode": "EQUALS", "value": true },
						{ "field": "data.password", "mode": "IS_NULL" }
					]
				},
				{
					"title": "Wrong password does not reveal that the password is expired",
					"method": "post",
					"url": "/api/user/login",
					"auth": false,
					"body": {
						"username": "%(pwexp_username)s",
						"password": "%(system_admin_password)s_wrong"
					},
					"status_code": 403,
					"ignore_error": true
				},
				{
					"rem": "SIZE 3 = requires_password_change, password_change_reason, pending_token: no token, no refresh_token (NOT_EXISTS cannot be used, it fails when the key is missing)"
				},
				{
					"title": "Login is blocked: pending token and NO session",
					"method": "post",
					"url": "/api/user/login",
					"auth": false,
					"body": {
						"username": "%(pwexp_username)s",
						"password": "%(system_admin_password)s"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.requires_password_change", "mode": "EQUALS", "value": true },
						{ "field": "data.password_change_reason", "mode": "EQUALS", "value": "flag" },
						{ "field": "data.pending_token", "mode": "EXISTS" },
						{ "field": "data", "mode": "SIZE", "value": 3 }
					],
					"fields": [
						["data.pending_token", "pwexp_pending_token"]
					]
				},
				{
					"title": "Change with a garbage token",
					"method": "post",
					"url": "/api/user/password/change-expired",
					"auth": false,
					"body": {
						"pending_token": "not-a-token",
						"password": "%(system_admin_password)s_changed"
					},
					"status_code": 401,
					"ignore_error": true
				},
				{
					"title": "A session token is not a password change token",
					"method": "post",
					"url": "/api/user/password/change-expired",
					"auth": false,
					"body": {
						"pending_token": "%(admin_token)s",
						"password": "%(system_admin_password)s_changed"
					},
					"status_code": 401,
					"ignore_error": true
				},
				{
					"title": "Password too short",
					"method": "post",
					"url": "/api/user/password/change-expired",
					"auth": false,
					"body": {
						"pending_token": "%(pwexp_pending_token)s",
						"password": "x"
					},
					"status_code": 400,
					"ignore_error": true
				},
				{
					"title": "New password equal to the current one",
					"method": "post",
					"url": "/api/user/password/change-expired",
					"auth": false,
					"body": {
						"pending_token": "%(pwexp_pending_token)s",
						"password": "%(system_admin_password)s"
					},
					"status_code": 400,
					"ignore_error": true
				},
				{
					"title": "Change the password: full login",
					"method": "post",
					"url": "/api/user/password/change-expired",
					"auth": false,
					"body": {
						"pending_token": "%(pwexp_pending_token)s",
						"password": "%(system_admin_password)s_changed"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.token", "mode": "EXISTS" },
						{ "field": "data.refresh_token", "mode": "EXISTS" },
						{ "field": "data.id", "mode": "EQUALS", "value": "%(pwexp_user_id)s" },
						{ "field": "data.requires_password_change", "mode": "EQUALS", "value": false }
					],
					"fields": [
						["data.token", "pwexp_new_token"]
					]
				},
				{
					"title": "The same token cannot be replayed",
					"method": "post",
					"url": "/api/user/password/change-expired",
					"auth": false,
					"body": {
						"pending_token": "%(pwexp_pending_token)s",
						"password": "%(system_admin_password)s_again"
					},
					"status_code": 400,
					"ignore_error": true
				},
				{
					"title": "Login with the new password: no more password change",
					"method": "post",
					"url": "/api/user/login",
					"auth": false,
					"body": {
						"username": "%(pwexp_username)s",
						"password": "%(system_admin_password)s_changed"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.token", "mode": "EXISTS" },
						{ "field": "data.requires_password_change", "mode": "EQUALS", "value": false }
					]
				},
				{
					"title": "The old password no longer works",
					"method": "post",
					"url": "/api/user/login",
					"auth": false,
					"body": {
						"username": "%(pwexp_username)s",
						"password": "%(system_admin_password)s"
					},
					"status_code": 403,
					"ignore_error": true
				},
				{
					"rem": "A user without the user.password permission cannot force a change on anybody"
				},
				{
					"action": "copy",
					"from": "pwexp_new_token",
					"to": "token"
				},
				{
					"title": "Plain user tries to set the flag",
					"method": "post",
					"url": "/api/user/set/password_expired",
					"auth": true,
					"body": {
						"id": "%(pwexp_user_id)s",
						"password_expired": true
					},
					"status_code": 403,
					"ignore_error": true
				},
				{
					"title": "Plain user tries to set the max age",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s", "days": 30 },
					"status_code": 403,
					"ignore_error": true
				},
				{
					"action": "copy",
					"from": "admin_token",
					"to": "token"
				},
				{
					"title": "Admin clears the flag",
					"method": "post",
					"url": "/api/user/set/password_expired",
					"auth": true,
					"body": {
						"id": "%(pwexp_user_id)s",
						"password_expired": false
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.password_expired", "mode": "EQUALS", "value": false }
					]
				},
				{
					"rem": "Per user max age: a value on the user wins over the global default, 0 = never, a missing days = use the default (null)"
				},
				{
					"title": "Set the max age to 45 days",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s", "days": 45 },
					"status_code": 200,
					"tests": [{ "field": "data.password_max_age_days", "mode": "EQUALS", "value": 45 }, { "field": "data.password", "mode": "IS_NULL" }]
				},
				{
					"title": "0 means the password never expires for this user",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s", "days": 0 },
					"status_code": 200,
					"tests": [{ "field": "data.password_max_age_days", "mode": "EQUALS", "value": 0 }]
				},
				{
					"title": "A null days clears the value too: it is not 0",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s", "days": null },
					"status_code": 200,
					"tests": [{ "field": "data.password_max_age_days", "mode": "IS_NULL" }]
				},
				{
					"title": "Set the max age to 45 days again",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s", "days": 45 },
					"status_code": 200,
					"tests": [{ "field": "data.password_max_age_days", "mode": "EQUALS", "value": 45 }]
				},
				{
					"title": "A missing days clears the value",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s" },
					"status_code": 200,
					"tests": [{ "field": "data.password_max_age_days", "mode": "IS_NULL" }]
				},
				{
					"title": "Negative days are rejected",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "%(pwexp_user_id)s", "days": -1 },
					"status_code": 400,
					"ignore_error": true
				},
				{
					"title": "Max age on an unknown user",
					"method": "post",
					"url": "/api/user/set/password_max_age",
					"auth": true,
					"body": { "id": "user.nonexistent.id", "days": 30 },
					"status_code": 404,
					"ignore_error": true
				},
				{
					"title": "Flag on an unknown user",
					"method": "post",
					"url": "/api/user/set/password_expired",
					"auth": true,
					"body": {
						"id": "user.nonexistent.id",
						"password_expired": true
					},
					"status_code": 404,
					"ignore_error": true
				},
				{
					"title": "Delete the test user",
					"method": "delete",
					"url": "/api/user/delete",
					"auth": true,
					"body": {
						"id": "%(pwexp_user_id)s"
					},
					"status_code": 200
				}
			]
		}
	]
}
