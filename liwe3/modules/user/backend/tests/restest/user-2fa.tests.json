{
	"actions": [
		{
			"action": "section",
			"title": "User 2FA Tests",
			"actions": [
				{
					"title": "Create test user for 2FA",
					"method": "post",
					"url": "/api/user/add",
					"auth": true,
					"body": {
						"username": "twofatest_1",
						"email": "twofatest_1@example.com",
						"password": "TwoFaTest123!",
						"enabled": true,
						"email_verified": true
					},
					"status_code": 200,
					"fields": [
						["data.id", "twofa_test_user_id"],
						["data.username", "twofa_test_username"]
					]
				},
				{
					"title": "Login with 2FA test user",
					"method": "post",
					"url": "/api/user/login",
					"auth": false,
					"body": {
						"username": "%(twofa_test_username)s",
						"password": "TwoFaTest123!"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data.token", "mode": "EXISTS" }
					],
					"fields": [
						["data.token", "twofa_test_token"]
					]
				},
				{
					"rem": "Store admin token and switch to the 2FA test user's token"
				},
				{
					"action": "copy",
					"from": "token",
					"to": "original_token"
				},
				{
					"action": "copy",
					"from": "twofa_test_token",
					"to": "token"
				},
				{
					"title": "Start 2FA setup",
					"method": "post",
					"url": "/api/user/2fa/setup",
					"auth": true,
					"status_code": 200,
					"tests": [
						{ "field": "data.secret", "mode": "EXISTS" },
						{ "field": "data.otpauth_url", "mode": "CONTAINS", "value": "otpauth://totp/" }
					]
				},
				{
					"rem": "A live TOTP code cannot be computed from restest's static JSON tests. The full setup -> enable -> login round trip (valid code, recovery code fallback) is covered by the vitest suites tests/user-2fa.test.ts and tests/user-login-2fa.test.ts."
				},
				{
					"title": "Reject enabling 2FA with an invalid code",
					"method": "post",
					"url": "/api/user/2fa/enable",
					"auth": true,
					"body": {
						"code": "000000"
					},
					"status_code": 400,
					"ignore_error": true
				},
				{
					"title": "Reject disabling 2FA with the wrong password",
					"method": "post",
					"url": "/api/user/2fa/disable",
					"auth": true,
					"body": {
						"password": "WrongPassword123!"
					},
					"status_code": 403,
					"ignore_error": true
				},
				{
					"title": "Disable 2FA with the correct password",
					"method": "post",
					"url": "/api/user/2fa/disable",
					"auth": true,
					"body": {
						"password": "TwoFaTest123!"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data", "mode": "EQUALS", "value": true }
					]
				},
				{
					"title": "Reject admin-disable from a caller without user.2fa.manage",
					"method": "post",
					"url": "/api/user/2fa/admin/disable",
					"auth": true,
					"body": {
						"id_user": "%(twofa_test_user_id)s"
					},
					"status_code": 403,
					"ignore_error": true
				},
				{
					"rem": "Restore the admin token"
				},
				{
					"action": "copy",
					"from": "original_token",
					"to": "token"
				},
				{
					"title": "Admin force-disables 2FA on the test user",
					"method": "post",
					"url": "/api/user/2fa/admin/disable",
					"auth": true,
					"body": {
						"id_user": "%(twofa_test_user_id)s"
					},
					"status_code": 200,
					"tests": [
						{ "field": "data", "mode": "EQUALS", "value": true }
					]
				},
				{
					"title": "Admin-disable a non-existent user returns 404",
					"method": "post",
					"url": "/api/user/2fa/admin/disable",
					"auth": true,
					"body": {
						"id_user": "nonexistent_user_xyz"
					},
					"status_code": 404,
					"ignore_error": true
				},
				{
					"title": "Delete 2FA test user",
					"method": "delete",
					"url": "/api/user/delete",
					"auth": true,
					"body": {
						"id": "%(twofa_test_user_id)s"
					},
					"status_code": 200
				}
			]
		}
	]
}
