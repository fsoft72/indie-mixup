{
	"actions": [
		{
			"title": "Get initial credentials count",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [["#data", "init_count"]]
		},
		{
			"title": "Create first credential (API key type)",
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "Test API Key",
				"type": "api_key",
				"metadata": {
					"service": "github",
					"description": "GitHub API access"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Test API Key"
				},
				{
					"field": "data.type",
					"value": "api_key"
				},
				{
					"field": "data.metadata.service",
					"value": "github"
				}
			],
			"fields": [["data.id", "cred_id_1"]]
		},
		{
			"title": "Create second credential (database type)",
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "Test Database",
				"type": "database",
				"metadata": {
					"host": "localhost",
					"port": 5432,
					"database": "testdb"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Test Database"
				},
				{
					"field": "data.type",
					"value": "database"
				}
			],
			"fields": [["data.id", "cred_id_2"]]
		},
		{
			"title": "Verify credentials were created",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": "${init_count + 2}"
				},
				{
					"field": "data[id='%(cred_id_1)s'].name",
					"value": "Test API Key"
				},
				{
					"field": "data[id='%(cred_id_2)s'].name",
					"value": "Test Database"
				}
			]
		},
		{
			"title": "Update first credential name",
			"method": "PATCH",
			"url": "/api/credentials/edit",
			"body": {
				"id": "%(cred_id_1)s",
				"name": "Updated API Key"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Updated API Key"
				},
				{
					"field": "data.type",
					"value": "api_key"
				}
			]
		},
		{
			"title": "Update first credential metadata",
			"method": "PATCH",
			"url": "/api/credentials/edit",
			"body": {
				"id": "%(cred_id_1)s",
				"metadata": {
					"service": "gitlab",
					"description": "GitLab API access",
					"updated": true
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.metadata.service",
					"value": "gitlab"
				},
				{
					"field": "data.metadata.updated",
					"value": true
				}
			]
		},
		{
			"title": "Verify updated credential in list",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data[id='%(cred_id_1)s'].name",
					"value": "Updated API Key"
				},
				{
					"field": "data[id='%(cred_id_1)s'].metadata.service",
					"value": "gitlab"
				}
			]
		},
		{
			"title": "Delete first credential",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(cred_id_1)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data",
					"value": true
				}
			]
		},
		{
			"title": "Verify first credential was deleted",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": "${init_count + 1}"
				}
			]
		},
		{
			"title": "Delete second credential",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(cred_id_2)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"title": "Verify all test credentials were deleted",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": "${init_count}"
				}
			]
		}
	]
}
