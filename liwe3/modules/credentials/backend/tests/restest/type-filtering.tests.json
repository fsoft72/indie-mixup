{
	"actions": [
		{
			"title": "Create multiple credentials of different types",
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "AWS Credentials",
				"type": "aws",
				"metadata": {
					"region": "us-east-1"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [
				["data.id", "aws_cred_id"]
			]
		},
		{
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "Azure Credentials",
				"type": "azure",
				"metadata": {
					"subscription": "test-sub"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [
				["data.id", "azure_cred_id"]
			]
		},
		{
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "GCP Credentials",
				"type": "gcp",
				"metadata": {
					"project": "test-project"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [
				["data.id", "gcp_cred_id"]
			]
		},
		{
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "Another AWS Credential",
				"type": "aws",
				"metadata": {
					"region": "eu-west-1"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [
				["data.id", "aws_cred_id_2"]
			]
		},
		{
			"title": "List all credentials without filter",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			],
			"fields": [
				["#data", "total_count"]
			]
		},
		{
			"title": "Filter credentials by type: aws (should return 2)",
			"method": "GET",
			"url": "/api/credentials/list",
			"body": {
				"type": "aws"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": 2
				},
				{
					"field": "data[id='%(aws_cred_id)s'].type",
					"value": "aws"
				},
				{
					"field": "data[id='%(aws_cred_id_2)s'].type",
					"value": "aws"
				}
			]
		},
		{
			"title": "Filter credentials by type: azure (should return 1)",
			"method": "GET",
			"url": "/api/credentials/list",
			"body": {
				"type": "azure"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": 1
				},
				{
					"field": "data[0].type",
					"value": "azure"
				},
				{
					"field": "data[0].name",
					"value": "Azure Credentials"
				}
			]
		},
		{
			"title": "Filter credentials by type: gcp (should return 1)",
			"method": "GET",
			"url": "/api/credentials/list",
			"body": {
				"type": "gcp"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": 1
				},
				{
					"field": "data[0].type",
					"value": "gcp"
				}
			]
		},
		{
			"title": "Filter credentials by non-existent type (should return 0)",
			"method": "GET",
			"url": "/api/credentials/list",
			"body": {
				"type": "nonexistent"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": 0
				}
			]
		},
		{
			"title": "Cleanup - Delete AWS credentials",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(aws_cred_id)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(aws_cred_id_2)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"title": "Cleanup - Delete Azure credentials",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(azure_cred_id)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"title": "Cleanup - Delete GCP credentials",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(gcp_cred_id)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"title": "Verify all test credentials are cleaned up",
			"method": "GET",
			"url": "/api/credentials/list",
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "#data",
					"value": "${total_count - 4}"
				}
			]
		}
	]
}
