{
	"actions": [
		{
			"title": "Create credential with encrypted data",
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "Encrypted API Key",
				"type": "api_key",
				"metadata": {
					"service": "stripe",
					"environment": "test"
				},
				"data_enc": {
					"api_key": "sk_test_123456789",
					"api_secret": "secret_key_abc"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Encrypted API Key"
				}
			],
			"fields": [["data.id", "encrypted_cred_id"]]
		},
		{
			"title": "Verify encrypted data is not returned in list",
			"method": "GET",
			"url": "/api/credentials/list",
			"body": {
				"type": "api_key"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"title": "Update credential with new encrypted data",
			"method": "PATCH",
			"url": "/api/credentials/edit",
			"body": {
				"id": "%(encrypted_cred_id)s",
				"data_enc": {
					"api_key": "sk_test_updated",
					"api_secret": "secret_key_updated",
					"webhook_secret": "whsec_new"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Encrypted API Key"
				}
			]
		},
		{
			"title": "Update only name, keep encrypted data unchanged",
			"method": "PATCH",
			"url": "/api/credentials/edit",
			"body": {
				"id": "%(encrypted_cred_id)s",
				"name": "Updated Encrypted Key"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Updated Encrypted Key"
				}
			]
		},
		{
			"title": "Update metadata without touching encrypted data",
			"method": "PATCH",
			"url": "/api/credentials/edit",
			"body": {
				"id": "%(encrypted_cred_id)s",
				"metadata": {
					"service": "stripe",
					"environment": "production",
					"updated_at": "2025-12-28"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.metadata.environment",
					"value": "production"
				}
			]
		},
		{
			"title": "Create credential without encrypted data",
			"method": "POST",
			"url": "/api/credentials/add",
			"body": {
				"name": "Public Credential",
				"type": "oauth",
				"metadata": {
					"client_id": "public_client_id",
					"redirect_uri": "https://example.com/callback"
				}
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				},
				{
					"field": "data.name",
					"value": "Public Credential"
				}
			],
			"fields": [["data.id", "public_cred_id"]]
		},
		{
			"title": "Cleanup - Delete encrypted credential",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(encrypted_cred_id)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		},
		{
			"title": "Cleanup - Delete public credential",
			"method": "DELETE",
			"url": "/api/credentials/del",
			"body": {
				"id": "%(public_cred_id)s"
			},
			"tests": [
				{
					"field": "ok",
					"value": true
				}
			]
		}
	]
}
