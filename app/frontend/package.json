{
	"name": "app-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npx vite dev",
		"build": "npx vite build",
		"preview": "npx vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "dprint fmt",
		"lint": "dprint check && eslint ."
	},
	"dependencies": {
		"@frontend/liwe3": "workspace:*",
		"@frontend-modules/indiegame": "workspace:*",
		"@frontend-modules/notifier": "workspace:*",
		"@frontend-modules/system": "workspace:*",
		"@frontend-modules/theme": "workspace:*",
		"@frontend-modules/upload": "workspace:*",
		"@frontend-modules/user": "workspace:*",
		"@liwe3/webcomponents": "file:../../../liwe3-webcomponents/packages/core",
		"@liwe3/webcomponents-svelte": "file:../../../liwe3-webcomponents/packages/svelte"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"vite": "^8.2.0",
		"zod": "^4.3.6"
	}
}
