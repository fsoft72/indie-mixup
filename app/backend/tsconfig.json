{
	"compilerOptions": {
		"target": "es2021",
		"lib": ["es2021"],
		"jsx": "react-jsx",
		"module": "es2022",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"./worker-configuration.d.ts"
		],
		"baseUrl": ".",
		"paths": {
			"$liwe3/core": ["../../liwe3/backend/core/index.ts"],
			"$liwe3/core/*": ["../../liwe3/backend/core/*"],
			"$liwe3/backend/*": ["../../liwe3/backend/*"],
			"$liwe3/modules/*": ["../../liwe3/modules/*/backend"],
			"$liwe3/common/*": ["../../liwe3/common/*"]
		}
	},
	"exclude": ["test"],
	"include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
