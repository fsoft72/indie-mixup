#!/usr/bin/env bash
#
# Pre-commit: format staged files with dprint (config: ./dprint.json), then
# re-stage them so the commit always contains dprint-formatted code.
#
# When a package.json or pnpm-workspace.yaml is staged, regenerates
# pnpm-lock.yaml (`pnpm install --lockfile-only`) and stages it, so CI's
# `--frozen-lockfile` install never sees an outdated lockfile. Unlike codegraph,
# a failure here blocks the commit.
#
# When the app modules, a package.json or a tsconfig is part of the commit, runs
# `work/scripts/sync_modules.py --check`: the files around app/backend/src/index.ts
# (package.json deps, tsconfig.backend.json, tsconfig references) must be in sync.
# A failure blocks the commit; fix it with `work/scripts/sync_modules.py`.
#
# Also refreshes the codegraph index when `codegraph` is on PATH. If it is
# missing or the index run fails, the hook logs a note and lets the commit
# proceed - codegraph is an optional developer convenience, never a gate.
#
# Enabled per-clone by `git config core.hooksPath .githooks`, which the root
# package.json "prepare" script runs automatically on `pnpm install`.

set -euo pipefail

# Resolve a dprint binary: PATH first, then a locally installed one.
if command -v dprint > /dev/null 2>&1; then
	DPRINT="dprint"
elif pnpm exec dprint --version > /dev/null 2>&1; then
	DPRINT="pnpm exec dprint"
else
	echo "[pre-commit] dprint not found. Install it: https://dprint.dev/install/ (or 'pnpm add -D dprint')" >&2
	exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Staged files that still exist on disk (Added / Copied / Modified / Renamed).
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#STAGED[@]}" -eq 0 ] && exit 0

# dprint decides which of these it actually understands; unknown paths are ignored.
# shellcheck disable=SC2086
$DPRINT fmt --allow-no-files -- "${STAGED[@]}"

# Re-stage only the files that were part of this commit.
RESTAGE=()
for f in "${STAGED[@]}"; do
	[ -f "$f" ] && RESTAGE+=("$f")
done
[ "${#RESTAGE[@]}" -gt 0 ] && git add -- "${RESTAGE[@]}"

# Keep pnpm-lock.yaml in sync when dependency manifests are part of the commit.
for f in "${STAGED[@]}"; do
	case "$f" in
		package.json | */package.json | pnpm-workspace.yaml)
			echo "[pre-commit] $f changed; regenerating pnpm-lock.yaml." >&2
			pnpm install --lockfile-only --ignore-scripts
			git add -- pnpm-lock.yaml
			break
			;;
	esac
done

# Keep the files around the app modules in sync (see work/scripts/sync_modules.py).
for f in "${STAGED[@]}"; do
	case "$f" in
		app/backend/src/index.ts | package.json | */package.json | tsconfig.backend.json | */tsconfig.json | work/scripts/sync_modules.py)
			if ! work/scripts/sync_modules.py --check >&2; then
				echo "[pre-commit] module config out of sync. Run work/scripts/sync_modules.py, then dprint fmt, and stage the result." >&2
				exit 1
			fi
			break
			;;
	esac
done

# Refresh the codegraph index. Optional: skip silently if not installed, and
# never fail the commit if indexing errors out.
if command -v codegraph > /dev/null 2>&1; then
	if ! codegraph index --quiet; then
		echo "[pre-commit] codegraph index failed; continuing without a fresh index." >&2
	fi
else
	echo "[pre-commit] codegraph not found; skipping index refresh." >&2
fi

exit 0
